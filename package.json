{
	"publisher": "tejanium",
	"name": "copy-github-permalink",
	"displayName": "Copy Github Permalink",
	"description": "Copy Github Permalink",
	"icon": "img/ico.png",
	"version": "1.1.0",
	"homepage": "https://github.com/tejanium/vscode-copy-github-permalink/blob/master/README.md",
	"bugs": {
		"url": "https://github.com/tejanium/vscode-copy-github-permalink/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/tejanium/vscode-copy-github-permalink"
	},
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Other"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "copy-github-permalink.copy",
				"title": "Github Permalink: Copy"
			}
		],
		"configuration": {
			"title": "Copy Github Permalink",
			"properties": {
				"copy-github-permalink.branch": {
					"type": "string",
					"enum": [
						"default",
						"HEAD",
						"custom"
					],
					"enumDescriptions": [
						"The remote's default branch (origin/main, origin/master, origin/trunk, ...), detected automatically.",
						"Your current checkout. The SHA may not exist on GitHub yet if it hasn't been pushed.",
						"The branch named in `copy-github-permalink.customBranch`."
					],
					"default": "default",
					"markdownDescription": "Which branch the permalink's SHA is taken from."
				},
				"copy-github-permalink.customBranch": {
					"type": "string",
					"default": "origin/master",
					"markdownDescription": "Branch or ref used when `#copy-github-permalink.branch#` is set to `custom`, e.g. `origin/release`."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run check-types && npm run lint && node esbuild.js",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch -p ./",
		"package": "npm run check-types && npm run lint && node esbuild.js --production",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile",
		"check-types": "tsc --noEmit",
		"lint": "eslint src",
		"test": "vscode-test",
		"vsix": "vsce package --out copy-github-permalink.vsix",
		"deploy": "npm run deploy:vscode && npm run deploy:openvsx",
		"deploy:vscode": "vsce publish --packagePath copy-github-permalink.vsix",
		"deploy:openvsx": "ovsx publish copy-github-permalink.vsix"
	},
	"overrides": {
		"mocha": "$mocha"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.15.0",
		"@types/sinon": "^17.0.4",
		"@types/vscode": "^1.90.0",
		"@vscode/test-cli": "^0.0.15",
		"@vscode/test-electron": "^3.1.0",
		"@vscode/vsce": "^3.6.0",
		"esbuild": "^0.25.0",
		"eslint": "^9.30.0",
		"mocha": "^12.0.1",
		"mock-spawn": "^0.2.6",
		"npm-run-all": "^4.1.5",
		"ovsx": "^1.2.0",
		"sinon": "^21.0.0",
		"typescript": "^5.8.0",
		"typescript-eslint": "^8.35.0"
	}
}
